POL_API_KEY=replace-with-random-api-key
POL_ADMIN_TOKEN=replace-with-random-admin-token
POL_SYNC_TOKEN=replace-with-random-sync-token
POL_DATABASE_PATH=data/pol2api.db
POL_TASK_WORKERS=5
POL_TASK_QUEUE_CAPACITY=100
POL_POLL_INTERVAL_SECONDS=5
POL_TASK_TIMEOUT_SECONDS=1800
POL_SYNCHRONOUS_TIMEOUT_SECONDS=120
POL_REQUEST_TIMEOUT_SECONDS=60
POL_REQUEST_RETRIES=2
POL_ACCOUNT_DEFAULT_CONCURRENCY=1
POL_ACCOUNT_MAINTENANCE_INTERVAL_SECONDS=300
POL_ACCOUNT_MAINTENANCE_WORKERS=3
POL_BROWSER_RECOVERY_ENABLED=true
POL_PROXY_POOL_ENABLED=false
POL_PROXY_POOL=
POL_PROXY_HOST_OVERRIDE=
POL_LOW_BALANCE_DISABLE_THRESHOLD=1
POL_EXCESS_MEDIA_POLICY=strict
POL_ALLOW_VIDEO_REFERENCE_INPUTS=true
POL_PROMPT_MEDIA_REFERENCE_CLEANUP_ENABLED=false
POL_MEDIA_MAX_BYTES=209715200
POL_FFPROBE_EXECUTABLE=ffprobe
POL2API_PORT=8798
